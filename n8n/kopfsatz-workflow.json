{"nodes": [{"id": "9ef908a3-8ab9-40be-b05f-aee05e05b810", "name": "Stimme anfordern", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0], "parameters": {"httpMethod": "POST", "path": "kopfsatz-stimme", "responseMode": "responseNode", "options": {}}, "webhookId": "a6bcdaff-62e2-495b-add8-dc4e70bd0b12"}, {"id": "86088283-6911-4b2e-89e1-30ce620f4551", "name": "Bank laden (Stimme)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0], "parameters": {"url": "=https://raw.githubusercontent.com/denizrisopp-art/kopfsatz/main/bank/zitate.json?t={{ Date.now() }}", "options": {"response": {"response": {"responseFormat": "json"}}}}}, {"id": "af6d5ce2-c45b-46aa-adc8-6b2ace450150", "name": "Text bauen", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [660, 0], "parameters": {"jsCode": "const id = String($('Stimme anfordern').first().json.body?.id || '');\nconst raw = $input.first().json;\nconst bank = Array.isArray(raw) ? raw : (raw.data ? JSON.parse(raw.data) : []);\nconst e = bank.find(x => x.id === id);\nif (!e || !Array.isArray(e.sprechtext) || e.sprechtext.length !== 7) return [{ json: { fehler: 'Eintrag unbekannt' } }];\nconst sd = $getWorkflowStaticData('global');\nconst heute = new Date().toISOString().slice(0, 10);\nif (sd.stimmeTag !== heute) { sd.stimmeTag = heute; sd.stimmeZahl = 0; }\nif ((sd.stimmeZahl || 0) >= 4) return [{ json: { fehler: 'Tageslimit Stimme erreicht' } }];\nsd.stimmeZahl = (sd.stimmeZahl || 0) + 1;\nconst text = e.sprechtext.map(t => String(t).replace(/\\s+/g, ' ').trim()).join(' ');\nreturn [{ json: { text } }];"}}, {"id": "a5d7eb2a-9986-4a0c-aa8c-5528ef608312", "name": "Text ok?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [880, 0], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "265f4006-896d-492c-9a68-b99a7f1a11ed", "leftValue": "={{ $json.text }}", "rightValue": "", "operator": {"type"